bazel_dep(name = "platforms", version = "0.0.8")

arm_none_eabi = use_extension(
    "//third_party/toolchains:toolchains.bzl",
    "arm_none_eabi",
)

use_repo(
    arm_none_eabi,
    "arm_none_eabi_linux_x86",
    "arm_none_eabi_macos_aarch64",
)

# Register toolchains from the module
register_toolchains(
    "//infrastructure/toolchain:cc_arm_none_eabi_linux_x86",
    "//infrastructure/toolchain:cc_arm_none_eabi_macos_aarch64",
)