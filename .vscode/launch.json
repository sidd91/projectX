{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/bazel-bin/example/freertos_blinky/example/example.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "svdFile": "${workspaceFolder}/third_party/nxp/lpc1769/artifacts/LPC176x5x.svd",
            "openOCDLaunchCommands": ["adapter speed 5000"],
            "configFiles": [
                "${workspaceFolder}/infrastructure/openocd/lpc1769/cmsis-dap.cfg",
                "${workspaceFolder}/infrastructure/openocd/lpc1769/lpc17xx.cfg",
            ],
            "gdbPath": "${workspaceFolder}/bazel-out/darwin_arm64-fastbuild/bin/external/toolchains_arm_gnu~1.0.2~arm_toolchain~arm_none_eabi/gdb", 
            "nmPath": "${workspaceFolder}/bazel-out/darwin_arm64-fastbuild/bin/external/toolchains_arm_gnu~1.0.2~arm_toolchain~arm_none_eabi/nm",
            "objdumpPath": "${workspaceFolder}/bazel-out/darwin_arm64-fastbuild/bin/external/toolchains_arm_gnu~1.0.2~arm_toolchain~arm_none_eabi/objdump",
            // "armToolchainPath": "bazel-out/darwin_arm64-fastbuild/bin/external/toolchains_arm_gnu~1.0.2~arm_toolchain~arm_none_eabi",
            "postLaunchCommands": ["load", "monitor reset halt"],
        }
    ]
}